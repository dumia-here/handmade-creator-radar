{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handmade-radar.local/schemas/radar-task.v0.1.schema.json",
  "title": "Adam Studio Cross-platform Creator Radar Task V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "title", "probes", "track_scope", "safety", "observation_signals", "acceptance_criteria"],
  "properties": {
    "schema_version": {"const": "radar.task.v0.1"},
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "mode", "queries"],
        "properties": {
          "platform": {
            "enum": ["xiaohongshu", "douyin", "bilibili", "weibo", "instagram", "tiktok", "youtube", "pinterest"]
          },
          "mode": {"enum": ["public", "authorized_import", "replay"]},
          "locale": {"type": ["string", "null"]},
          "queries": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "track_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude", "portable_methods", "cross_track_requires_note"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "portable_methods": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cross_track_requires_note": {"type": "boolean"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "forbidden_actions"],
      "properties": {
        "read_only": {"const": true},
        "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "observation_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "deliverables": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
