{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radar-platform-score.v0.1.schema.json",
  "title": "Radar Platform Score V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "score", "confidence", "tier", "signals", "facts", "inferences", "missing", "conflicts", "reason_codes", "needs_confirmation", "evidence_threshold_met"],
  "properties": {
    "platform": {"type": "string"},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tier": {"enum": ["main", "experiment", "observe", "insufficient_evidence"]},
    "signals": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["signal", "score", "confidence", "evidence_count", "missing_count", "reasons"],
        "properties": {
          "signal": {"type": "string"},
          "score": {"type": ["number", "null"]},
          "confidence": {"type": "number"},
          "evidence_count": {"type": "integer", "minimum": 0},
          "missing_count": {"type": "integer", "minimum": 0},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "facts": {"type": "array", "items": {"type": "string"}},
    "inferences": {"type": "array", "items": {"type": "string"}},
    "missing": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "needs_confirmation": {"type": "boolean"},
    "evidence_threshold_met": {"type": "boolean"}
  }
}
